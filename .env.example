# ===================================================
# PostGram — Zero-Cost Production Environment Variables
# ===================================================

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security: Explicit CORS Origin Whitelist (default: https://viralokit.vercel.app)
ALLOWED_ORIGIN=https://viralokit.vercel.app

# ---------------------------------------------------
# Supabase (Auth + Database + RLS)
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional single-tenant authorization allowlist (comma-separated Supabase user IDs)
ADMIN_WORKOS_USER_IDS=user_01H...example

# ---------------------------------------------------
# Meta Graph API (Official Instagram Platform)
# ---------------------------------------------------
# Default Meta Graph API version verified from Meta Developer Docs
META_GRAPH_API_VERSION=v23.0
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Security: 32-byte hex string used to encrypt OAuth tokens in the database
ENCRYPTION_KEY=generate_a_random_64_character_hex_string

# ---------------------------------------------------
# Cloudinary (Free Plan — https://cloudinary.com)
# ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------------------------------------------------
# AI Services (Zero Cost)
# ---------------------------------------------------
# OpenRouter API Key for dynamic free models (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Gemini API Key for multimodal fallback (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
